// Esquema de datos de Compr-Ya.
//
// Convención importante: TODO valor monetario se guarda como entero en la
// unidad mínima de la moneda, para evitar los errores de redondeo de los
// números decimales. Con la moneda por defecto (guaraní paraguayo, que no tiene
// centavos) el factor es 1: ₲ 250.000 se guarda como 250000. Con una moneda con
// centavos el factor es 100. Ver `FACTOR_MONEDA` en `src/lib/config.ts`; para
// mostrarlo en pantalla se usa `formatearDinero()` de `src/lib/formato.ts`.
//
// SQLite no soporta enums, por lo que los campos de tipo "estado" son String.
// Los valores válidos y sus etiquetas viven en `src/lib/dominio.ts`, que es la
// única fuente de verdad para la interfaz.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// Recursos humanos y estructura de venta
// ---------------------------------------------------------------------------

model Equipo {
  id          String   @id @default(cuid())
  nombre      String   @unique
  descripcion String?
  /// Meta de ventas mensual del equipo, en la unidad mínima de la moneda.
  metaMensual Int      @default(0)
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())

  liderId String?   @unique
  lider   Empleado? @relation("LiderDeEquipo", fields: [liderId], references: [id], onDelete: SetNull)

  miembros Empleado[] @relation("MiembroDeEquipo")
}

model Empleado {
  id                  String    @id @default(cuid())
  nombre              String
  email               String    @unique
  telefono            String
  /// Ver ROLES en src/lib/dominio.ts (ADMIN, LIDER, VENDEDOR, REPARTIDOR, ALMACEN).
  rol                 String
  activo              Boolean   @default(true)
  fechaIngreso        DateTime  @default(now())
  fechaBaja           DateTime?
  /// Sueldo base mensual, en la unidad mínima de la moneda.
  salarioBase         Int       @default(0)
  /// Fracción de comisión sobre la venta. 0.08 = 8 %.
  tasaComision        Float     @default(0)
  /// Meta de ventas mensual individual, en la unidad mínima de la moneda.
  metaMensual         Int       @default(0)
  notas               String?
  /// Hash de la contraseña (scrypt). Nulo mientras no se le dé acceso al
  /// sistema: alguien puede estar en la nómina sin poder entrar todavía.
  passwordHash        String?
  /// Obliga a cambiar la contraseña en el próximo inicio de sesión. Se activa
  /// cuando administración la asigna o la restablece.
  debeCambiarPassword Boolean   @default(false)
  ultimoAccesoAt      DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  equipoId       String?
  equipo         Equipo? @relation("MiembroDeEquipo", fields: [equipoId], references: [id], onDelete: SetNull)
  /// Equipo que esta persona lidera (si aplica).
  equipoLiderado Equipo? @relation("LiderDeEquipo")

  leads       Lead[]
  pedidos     Pedido[]
  entregas    Envio[]
  mensajes    MensajeWhatsApp[]
  movimientos MovimientoInventario[]
  asistencias Asistencia[]
  comisiones  Comision[]
  compras     Compra[]
  gastos      Gasto[]
  rendiciones Rendicion[] @relation("RepartidorDeRendicion")
  recibidas   Rendicion[] @relation("ReceptorDeRendicion")
  sesiones    Sesion[]
  auditoria   Auditoria[]

  @@index([rol])
  @@index([equipoId])
}

model Asistencia {
  id      String    @id @default(cuid())
  fecha   DateTime
  entrada DateTime?
  salida  DateTime?
  /// Ver ESTADOS_ASISTENCIA: PRESENTE, TARDE, AUSENTE, PERMISO, DESCANSO.
  estado  String
  notas   String?

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@unique([empleadoId, fecha])
  @@index([fecha])
}

model Comision {
  id         String    @id @default(cuid())
  /// Monto sobre el que se calculó la comisión (subtotal del pedido), en la unidad mínima de la moneda.
  base       Int
  /// Fracción aplicada en el momento del cálculo. Se congela para que un cambio
  /// posterior en la tasa del vendedor no altere comisiones ya generadas.
  porcentaje Float
  /// Resultado en la unidad mínima de la moneda.
  monto      Int
  /// Ver ESTADOS_COMISION: PENDIENTE, APROBADA, PAGADA, CANCELADA.
  estado     String    @default("PENDIENTE")
  /// Periodo contable en formato AAAA-MM.
  periodo    String
  createdAt  DateTime  @default(now())
  pagadaAt   DateTime?

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  @@index([periodo])
  @@index([empleadoId, periodo])
}

// ---------------------------------------------------------------------------
// Catálogo e inventario
// ---------------------------------------------------------------------------

model Producto {
  id          String   @id @default(cuid())
  sku         String   @unique
  nombre      String
  descripcion String?
  categoria   String
  /// Costo de adquisición, en la unidad mínima de la moneda.
  costo       Int
  /// Precio de venta al público, en la unidad mínima de la moneda.
  precio      Int
  stock       Int      @default(0)
  /// Umbral a partir del cual el producto se marca como stock bajo.
  stockMinimo Int      @default(5)
  imagenUrl   String?
  activo      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  movimientos      MovimientoInventario[]
  items            ItemPedido[]
  itemsCompra      ItemCompra[]
  leadsInteresados Lead[]

  @@index([categoria])
}

model MovimientoInventario {
  id              String   @id @default(cuid())
  /// Ver TIPOS_MOVIMIENTO: ENTRADA, SALIDA, AJUSTE, DEVOLUCION, MERMA.
  tipo            String
  /// Cantidad siempre positiva. El `tipo` determina el signo.
  cantidad        Int
  /// Stock que quedó tras aplicar el movimiento. Sirve de auditoría.
  stockResultante Int
  motivo          String?
  /// Referencia libre: código de pedido, factura del proveedor, etc.
  referencia      String?
  createdAt       DateTime @default(now())

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Cascade)

  empleadoId String?
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)

  @@index([productoId, createdAt])
}

// ---------------------------------------------------------------------------
// TikTok: campañas, prospectos y conversaciones de WhatsApp
// ---------------------------------------------------------------------------

model Campana {
  id          String    @id @default(cuid())
  nombre      String
  /// Ver TIPOS_CAMPANA: VIDEO, LIVE, ADS, PERFIL.
  tipo        String
  urlVideo    String?
  hashtags    String?
  /// Inversión publicitaria, en la unidad mínima de la moneda.
  presupuesto Int       @default(0)
  fechaInicio DateTime  @default(now())
  fechaFin    DateTime?
  activa      Boolean   @default(true)
  createdAt   DateTime  @default(now())

  leads Lead[]
}

model Lead {
  id               String    @id @default(cuid())
  codigo           String    @unique
  nombre           String
  telefono         String
  ciudad           String?
  /// Ver ORIGENES_LEAD: TIKTOK_VIDEO, TIKTOK_LIVE, TIKTOK_ADS, PERFIL, REFERIDO, OTRO.
  origen           String
  /// Ver ESTADOS_LEAD: NUEVO, CONTACTADO, EN_CONVERSACION, COTIZADO, GANADO, PERDIDO.
  estado           String    @default("NUEVO")
  /// Motivo registrado cuando el estado es PERDIDO.
  motivoPerdida    String?
  notas            String?
  ultimoContactoAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  campanaId String?
  campana   Campana? @relation(fields: [campanaId], references: [id], onDelete: SetNull)

  productoInteresId String?
  productoInteres   Producto? @relation(fields: [productoInteresId], references: [id], onDelete: SetNull)

  vendedorId String?
  vendedor   Empleado? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  mensajes MensajeWhatsApp[]
  pedidos  Pedido[]

  @@index([estado])
  @@index([vendedorId])
  @@index([createdAt])
}

model PlantillaWhatsApp {
  id        String   @id @default(cuid())
  nombre    String   @unique
  /// Etapa del embudo en la que se sugiere usarla. Coincide con ESTADOS_LEAD.
  etapa     String
  /// Texto con variables entre llaves dobles: {{cliente}}, {{producto}}, {{precio}}...
  cuerpo    String
  activa    Boolean  @default(true)
  createdAt DateTime @default(now())

  mensajes MensajeWhatsApp[]
}

model MensajeWhatsApp {
  id        String   @id @default(cuid())
  /// SALIENTE (de la tienda al cliente) o ENTRANTE (respuesta del cliente).
  direccion String
  cuerpo    String
  createdAt DateTime @default(now())

  leadId String
  lead   Lead   @relation(fields: [leadId], references: [id], onDelete: Cascade)

  plantillaId String?
  plantilla   PlantillaWhatsApp? @relation(fields: [plantillaId], references: [id], onDelete: SetNull)

  empleadoId String?
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)

  @@index([leadId, createdAt])
}

// ---------------------------------------------------------------------------
// Pedidos, envíos y zonas de reparto
// ---------------------------------------------------------------------------

model Zona {
  id             String  @id @default(cuid())
  nombre         String  @unique
  ciudad         String
  /// Tarifa de envío que se cobra al cliente, en la unidad mínima de la moneda.
  costoEnvio     Int
  /// Tiempo de entrega prometido, en horas.
  horasEstimadas Int     @default(48)
  activa         Boolean @default(true)

  envios Envio[]
}

model Pedido {
  id     String @id @default(cuid())
  codigo String @unique

  clienteNombre String
  telefono      String
  direccion     String
  ciudad        String
  /// Referencia de ubicación: "portón verde", "frente a la farmacia"...
  referencia    String?

  /// Ver ESTADOS_PEDIDO: PENDIENTE, CONFIRMADO, PREPARANDO, ENVIADO, ENTREGADO,
  /// CANCELADO, DEVUELTO.
  estado     String @default("PENDIENTE")
  /// Ver METODOS_PAGO: CONTRA_ENTREGA, TRANSFERENCIA, TARJETA.
  metodoPago String @default("CONTRA_ENTREGA")

  /// Todos en la unidad mínima de la moneda.
  subtotal   Int @default(0)
  costoEnvio Int @default(0)
  descuento  Int @default(0)
  total      Int @default(0)

  notas        String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  confirmadoAt DateTime?
  cerradoAt    DateTime?

  leadId String?
  lead   Lead?   @relation(fields: [leadId], references: [id], onDelete: SetNull)

  vendedorId String?
  vendedor   Empleado? @relation(fields: [vendedorId], references: [id], onDelete: SetNull)

  items    ItemPedido[]
  envio    Envio?
  comision Comision?

  @@index([estado])
  @@index([createdAt])
  @@index([vendedorId])
}

model ItemPedido {
  id             String @id @default(cuid())
  cantidad       Int
  /// Precio congelado en el momento de la venta, en la unidad mínima de la moneda. No se lee del
  /// producto para que un cambio de precio no altere pedidos históricos.
  precioUnitario Int
  /// cantidad * precioUnitario, en la unidad mínima de la moneda.
  subtotal       Int
  /// Lo que costaba el producto el día de la venta. Se congela por el mismo
  /// motivo que el precio: si el margen se recalculara con el costo de hoy, una
  /// reposición más cara haría parecer que se perdió plata en ventas viejas.
  /// Los pedidos anteriores a este campo quedan en 0 y hay que leerlos sabiendo
  /// que su margen sale inflado.
  costoUnitario  Int @default(0)

  pedidoId String
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id], onDelete: Restrict)

  @@unique([pedidoId, productoId])
}

model Envio {
  id              String    @id @default(cuid())
  /// Ver ESTADOS_ENVIO: POR_ASIGNAR, ASIGNADO, EN_RUTA, ENTREGADO, FALLIDO,
  /// REPROGRAMADO, DEVUELTO.
  estado          String    @default("POR_ASIGNAR")
  guia            String?
  fechaProgramada DateTime?
  fechaEntrega    DateTime?
  /// Número de intentos de entrega realizados.
  intentos        Int       @default(0)
  /// Lo que costó realmente la entrega (gasolina, mensajería), en la unidad mínima de la moneda.
  costoReal       Int?
  /// Efectivo cobrado al cliente en entregas contra entrega, en la unidad mínima de la moneda.
  montoCobrado    Int?
  observaciones   String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  pedidoId String @unique
  pedido   Pedido @relation(fields: [pedidoId], references: [id], onDelete: Cascade)

  zonaId String?
  zona   Zona?   @relation(fields: [zonaId], references: [id], onDelete: SetNull)

  repartidorId String?
  repartidor   Empleado? @relation(fields: [repartidorId], references: [id], onDelete: SetNull)

  /// Rendición en la que este cobro ya fue entregado. Nulo mientras la plata
  /// siga en manos del repartidor. Es lo que impide contar un cobro dos veces
  /// o dejarlo sin rendir sin que se note.
  rendicionId String?
  rendicion   Rendicion? @relation(fields: [rendicionId], references: [id], onDelete: SetNull)

  @@index([estado])
  @@index([repartidorId])
  @@index([rendicionId])
}

// ---------------------------------------------------------------------------
// Acceso al sistema
// ---------------------------------------------------------------------------

model Sesion {
  id        String   @id @default(cuid())
  /// Hash del token que viaja en la cookie. Se guarda el hash y no el token en
  /// claro para que quien lea la base no pueda suplantar a nadie.
  tokenHash String   @unique
  createdAt DateTime @default(now())
  expiraAt  DateTime
  /// Datos del navegador, para que una persona pueda reconocer sus sesiones.
  agente    String?

  empleadoId String
  empleado   Empleado @relation(fields: [empleadoId], references: [id], onDelete: Cascade)

  @@index([empleadoId])
  @@index([expiraAt])
}

// ---------------------------------------------------------------------------
// Auditoría
// ---------------------------------------------------------------------------

model Auditoria {
  id        String   @id @default(cuid())
  /// Qué se hizo, en formato "entidad.verbo": empleado.actualizar, comision.pagar…
  /// Los valores válidos están en ACCIONES_AUDITADAS (src/lib/auditoria.ts).
  accion    String
  /// Sobre qué se hizo. Permite ver el historial de un registro concreto.
  entidad   String
  entidadId String?
  /// Frase legible, para poder leer el registro sin descifrar el JSON.
  resumen   String
  /// Campos que cambiaron, como JSON: {"salarioBase":{"antes":1,"despues":2}}.
  /// Nulo cuando la acción no es una modificación.
  cambios   String?
  createdAt DateTime @default(now())

  /// Quién lo hizo. Nulo cuando no había sesión (un intento de acceso fallido).
  empleadoId String?
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)
  /// Nombre de quien actuó, copiado en el momento. Se guarda aparte del vínculo
  /// para que el registro siga siendo legible aunque la persona se elimine, y
  /// para poder anotar un correo en un intento de acceso fallido.
  actor      String

  @@index([createdAt])
  @@index([entidad, entidadId])
  @@index([empleadoId])
  @@index([accion])
}

// ---------------------------------------------------------------------------
// Administración: suministros, gastos y contabilidad
// ---------------------------------------------------------------------------

model Proveedor {
  id        String   @id @default(cuid())
  nombre    String
  /// RUC paraguayo, si lo tiene. Hace falta para que el gasto sea deducible.
  ruc       String?
  contacto  String?
  telefono  String?
  notas     String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  compras Compra[]
  gastos  Gasto[]

  @@index([nombre])
}

/// Una compra de mercadería al proveedor. Es el egreso más grande del negocio
/// y hasta ahora no se registraba en ninguna parte: la entrada de stock sabía
/// cuántas unidades llegaban, pero no cuánto se había pagado por ellas.
model Compra {
  id      String @id @default(cuid())
  numero  String @unique
  /// Ver ESTADOS_COMPRA: BORRADOR, RECIBIDA, PAGADA, ANULADA.
  estado  String @default("BORRADOR")
  /// Número de la factura del proveedor, para cruzar con la contabilidad.
  factura String?
  fecha   DateTime @default(now())
  /// Suma de las líneas, en la unidad mínima de la moneda. Se recalcula al
  /// guardar; no se escribe a mano.
  total   Int      @default(0)
  notas   String?
  /// Cuándo entró la mercadería al depósito. Nulo mientras sea un borrador.
  recibidaAt DateTime?
  /// Cuándo se le pagó al proveedor. Nulo mientras se le deba.
  pagadaAt   DateTime?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  proveedorId String
  proveedor   Proveedor @relation(fields: [proveedorId], references: [id])

  /// Quién la cargó.
  empleadoId String?
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)

  items ItemCompra[]

  @@index([estado, fecha])
  @@index([proveedorId])
}

model ItemCompra {
  id       String @id @default(cuid())
  cantidad Int
  /// Lo que se pagó por unidad EN ESTA COMPRA. Se congela igual que el precio
  /// de venta en ItemPedido: una compra posterior más cara no puede reescribir
  /// lo que costó la mercadería que ya se vendió.
  costoUnitario Int
  /// cantidad * costoUnitario, en la unidad mínima de la moneda.
  subtotal      Int

  compraId String
  compra   Compra @relation(fields: [compraId], references: [id], onDelete: Cascade)

  productoId String
  producto   Producto @relation(fields: [productoId], references: [id])

  @@index([compraId])
  @@index([productoId])
}

/// Gastos que no están atados a ninguna venta: alquiler, internet, embalaje,
/// comisiones del banco, contador. Son los que se comen la ganancia sin que se
/// note, porque no aparecen en ningún pedido.
///
/// Aquí NO van las comisiones de vendedores ni la inversión en campañas: ya
/// viven en Comision y en Campana. Duplicarlas haría que el estado de
/// resultados las contara dos veces.
model Gasto {
  id          String   @id @default(cuid())
  /// Ver CATEGORIAS_GASTO.
  categoria   String
  descripcion String
  /// En la unidad mínima de la moneda.
  monto       Int
  fecha       DateTime @default(now())
  /// Número de factura o recibo, para la contabilidad.
  comprobante String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  proveedorId String?
  proveedor   Proveedor? @relation(fields: [proveedorId], references: [id], onDelete: SetNull)

  /// Quién lo cargó.
  empleadoId String?
  empleado   Empleado? @relation(fields: [empleadoId], references: [id], onDelete: SetNull)

  @@index([fecha])
  @@index([categoria])
}

/// El cierre de caja de un repartidor: cuánta plata trae y cuánta dice el
/// sistema que cobró.
///
/// Con cobro contra entrega, el efectivo anda en el bolsillo de quien reparte.
/// `Envio.montoCobrado` sabe cuánto se cobró, pero no sabía si llegó. Cada
/// envío queda atado a una sola rendición: así un cobro no se puede contar dos
/// veces ni quedar sin rendir sin que aparezca en la lista de pendientes.
model Rendicion {
  id     String   @id @default(cuid())
  numero String   @unique
  fecha  DateTime @default(now())
  /// Lo que el sistema calculó que debía traer, congelado en el momento de
  /// cerrar: si se recalculara después, un envío corregido más tarde cambiaría
  /// una diferencia que ya se discutió y se dio por saldada.
  esperado   Int
  /// Lo que el repartidor entregó de verdad.
  declarado  Int
  /// declarado − esperado. Negativo es faltante.
  diferencia Int
  notas      String?
  createdAt  DateTime @default(now())

  repartidorId String
  repartidor   Empleado @relation("RepartidorDeRendicion", fields: [repartidorId], references: [id])

  /// Quién recibió la plata.
  recibidoPorId String?
  recibidoPor   Empleado? @relation("ReceptorDeRendicion", fields: [recibidoPorId], references: [id], onDelete: SetNull)

  envios Envio[]

  @@index([repartidorId, fecha])
}
