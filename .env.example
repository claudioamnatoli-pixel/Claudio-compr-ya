# Base de datos. En desarrollo usamos SQLite (no requiere instalar nada).
DATABASE_URL="file:./dev.db"

# Clave con la que se firman las cookies de sesión.
# En producción, genera una propia con: openssl rand -base64 32
SESSION_SECRET="cambia-esta-clave-antes-de-usarlo-en-produccion"

# Nombre público de la tienda, aparece en la interfaz y en las plantillas.
NEXT_PUBLIC_NOMBRE_TIENDA="Compr-Ya"

# Prefijo telefónico del país, sin el signo +. Paraguay es 595.
# Los números locales que empiezan con 0 (0981…) se normalizan solos.
NEXT_PUBLIC_PREFIJO_PAIS="595"

# Moneda y formato regional. El guaraní no tiene centavos y el sistema lo
# detecta solo: los importes se guardan y se escriben sin decimales.
NEXT_PUBLIC_MONEDA="PYG"
NEXT_PUBLIC_LOCALE="es-PY"
