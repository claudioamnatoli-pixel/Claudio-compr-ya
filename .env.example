# Base de datos. En desarrollo usamos SQLite (no requiere instalar nada).
DATABASE_URL="file:./dev.db"

# Nombre público de la tienda, aparece en la interfaz y en las plantillas.
NEXT_PUBLIC_NOMBRE_TIENDA="Compr-Ya"

# Prefijo telefónico del país, sin el signo +. Se usa para armar los enlaces wa.me.
NEXT_PUBLIC_PREFIJO_PAIS="52"

# Moneda usada al formatear precios (código ISO 4217) y su configuración regional.
NEXT_PUBLIC_MONEDA="MXN"
NEXT_PUBLIC_LOCALE="es-MX"
